@{
    ViewData["Title"] = " Modificar Productos"; // Cambia el título según sea necesario
}

@using claseCliente;
@model Cliente

<h1>Modificar Producto</h1>

<form asp-controller="Producto" asp-action="ModificarProducto">
    <div class="form-group">
        <label asp-for="@Model.ClienteId"></label>
        <input asp-for="@Model.ClienteId" class="form-control" />
        <label asp-for="@Model.Nombre"></label>
        <input asp-for="@Model.Nombre" class="form-control" />
        <label asp-for="@Model.Email"></label>
        <input asp-for="@Model.Email" class="form-control" />
        <label asp-for="@Model.Telefono"></label>
        <input asp-for="@Model.Telefono" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

