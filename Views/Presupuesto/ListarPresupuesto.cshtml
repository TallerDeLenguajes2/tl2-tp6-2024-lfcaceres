@{
  ViewData["Title"] = "Lista de Presupuestos"; // Cambia el título según sea necesario
}

@using MVC.Models
@model List<Presupuesto>

<h1>Lista de Presupuestos</h1>

<table class="table table-striped table-dark">
  <thead>
    <tr>
      <th scope="col">ID Presupuesto</th>
      <th scope="col">ID Cliente</th>
      <th scope="col">Nombre</th>
      <th scope="col">Email</th>
      <th scope="col">Telefono</th>
      <th scope="col">Cantidad</th>
      <th scope="col">Id Producto</th>
      <th scope="col">Descripcion</th>
      <th scope="col">Precio</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var p in Model)
    {
      foreach (var d in p.Detalle)
      {
          <tr>
            <td>@p.IdPresupuesto</td>
            <td>@p.Clientes.ClienteId</td>
            <td>@p.Clientes.Nombre</td>
            <td>@p.Clientes.Email</td>
            <td>@p.Clientes.Telefono</td>

            <td>@d.Cantidad</td>
            <td>@d.Producto.IdProducto</td>
            <td>@d.Producto.Descripcion</td>
            <td>@d.Producto.Precio</td>
          </tr>
      }
    }
  </tbody>
</table>
