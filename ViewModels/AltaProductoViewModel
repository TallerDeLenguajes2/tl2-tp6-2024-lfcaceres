namespace MVC.ViewModels
{
    public class AltaProductoViewModel
    {
        string descripcion;
        int precio;
        public AltaProductoViewModel(string Desc, int Pre) : descripcion(Desc), precio(Pre)
        {

        }
        public AltaProductoViewModel(Producto p) : descripcion(p.descripcion), precio(p.precio)
        {

        }

        public global::System.String Descripcion { get => descripcion; set => descripcion = value; }
        public global::System.Int32 Precio { get => precio; set => precio = value; }
    }
}