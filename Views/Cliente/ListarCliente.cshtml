@{
    ViewData["Title"] = "Lista de Productos"; // Cambia el título según sea necesario
}

@using claseCliente;
@model List<Cliente>

<h1>Lista de Clientes</h1>

<table class="table table-striped table-dark">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Nombre</th>
      <th scope="col">Email</th>
      <th scope="col">Telefono</th>
    </tr>
  </thead>
  <tbody>
    @foreach(var p in Model)
    {
    <tr>
      <td>@p.ClienteId</td>
      <td>@p.Nombre</td>
      <td>@p.Email</td>
      <td>@p.Telefono</td>
    </tr>
    }
  </tbody>
</table>

